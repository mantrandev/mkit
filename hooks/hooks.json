{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "R=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -x \"$R/.mkit/bin/mkit-gate\" ] && MKIT_ROOT=\"$R\" \"$R/.mkit/bin/mkit-gate\" turn >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "R=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -x \"$R/.mkit/bin/mkit-gate\" ] || exit 0; MKIT_ROOT=\"$R\" exec \"$R/.mkit/bin/mkit-gate\" check"
          }
        ]
      }
    ]
  }
}
